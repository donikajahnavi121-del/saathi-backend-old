    "jest": "^29.7.0",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
