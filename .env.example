# Saathi Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saathi_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Secrets (Use strong random 256-bit keys in production)
JWT_ACCESS_SECRET="saathi_access_secret_super_secure_key_2026_adherence_care"
JWT_REFRESH_SECRET="saathi_refresh_secret_super_secure_key_2026_adherence_care"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Field-Level Encryption Key for AES-256-GCM (Must be exactly 32 bytes / 64 hex chars)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"

# File Upload Configuration
PHOTO_UPLOAD_DIR="./uploads/photos"
MAX_PHOTO_SIZE_BYTES=5242880

# Demo API Keys (Hashed in DB, raw value passed in x-api-key header)
FRONTEND_API_KEY="saathi_fe_key_2026_prod_demo_live"
IVR_API_KEY="saathi_ivr_key_2026_webhook_secure"
ADMIN_API_KEY="saathi_adm_key_2026_supervisor_tool"
